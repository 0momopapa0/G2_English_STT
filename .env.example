# Copy to .env.local. Server-only Soniox key (Temporary API keys and real-time STT permissions).
# Never prefix this variable with VITE_: that would expose it in the browser.
SONIOX_API_KEY=

# Optional: HTTPS token backend for a deployed / packaged app (not an API key).
# If empty, npm run dev provides /api/stt-token on the same origin.
VITE_STT_TOKEN_URL=

# Optional: only requested when you click "OpenAI로 다시 요약".
# The free local summary needs no OpenAI key. Keep this server-only.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-6.1-terra

# Optional HTTPS summary backend for packaged deployments (not an API key).
VITE_SUMMARY_URL=
